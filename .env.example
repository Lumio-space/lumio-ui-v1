# Lumio - Environment variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
API_SECRET_KEY=your_internal_api_secret_key

# Authentication (next-auth)
# generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Database (if using Prisma / direct DB access)
# DATABASE_URL=postgresql://user:password@localhost:5432/lumio

# File Storage (school logo uploads)
# STORAGE_BUCKET=lumio-uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key

# Email (announcements, invites)
# EMAIL_FROM=noreply@lumio.edu
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
